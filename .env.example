# Copy to .env. Never commit real keys.
FORGE_LLM_PROVIDER=openrouter-free
FORGE_LLM_BASE_URL=https://openrouter.ai/api/v1
FORGE_LLM_MODEL=auto
FORGE_LLM_API_KEY=
# OPENROUTER_API_KEY is also accepted. No other provider key is imported.
# Owner-confirmed Groq Free plan alternative:
# FORGE_LLM_PROVIDER=groq-free
# FORGE_LLM_BASE_URL=https://api.groq.com/openai/v1
# FORGE_GROQ_FREE_PLAN_CONFIRMED=true
# FORGE_LLM_MODEL=auto
# FORGE_LLM_API_KEY=your-free-plan-groq-key
FORGE_GITHUB_AUTH=app
# Optional personal mode uses existing GitHub CLI sign-in and an explicit allowlist:
# FORGE_GITHUB_AUTH=cli
# FORGE_ALLOWED_REPOSITORIES=your-user/your-test-repository
FORGE_GITHUB_APP_ID=
FORGE_GITHUB_PRIVATE_KEY_PATH=.forge/github-app.pem
FORGE_GITHUB_INSTALLATION_ID=0
FORGE_GITHUB_WEBHOOK_SECRET=
FORGE_PUBLISH_ENABLED=false
# Local alternative (set all three and restart):
# FORGE_LLM_PROVIDER=local
# FORGE_LLM_BASE_URL=http://127.0.0.1:11434/v1
# FORGE_LLM_MODEL=your-installed-model
# FORGE_LLM_API_KEY=local
FORGE_DATABASE_URL=sqlite:///.forge/forge.sqlite3
FORGE_MAX_CALLS=20
FORGE_MAX_TOKENS=100000
FORGE_MAX_RUN_SECONDS=1200
FORGE_RUNNER_REPOSITORY=KaartikeyKusshwaha/Forge
FORGE_RUNNER_REF=main
